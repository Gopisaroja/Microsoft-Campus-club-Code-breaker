# Server
PORT=3000
NODE_ENV=development

# Official challenge calendar (Asia/Kolkata by default)
GAME_START_DATE=2026-08-26
TIMEZONE=Asia/Kolkata

# HMAC secret used to derive the daily code. Keep this private.
# All players on the same day share the same code.
CODE_SECRET=change-me-to-a-long-random-string

# Signs player and organizer cookies. Keep this private.
SESSION_SECRET=change-me-to-another-long-random-string

# Organizer dashboard password (never expose this to the frontend)
ORGANIZER_PASSWORD=change-me-strong-password
ORGANIZER_EMAIL=gopisarojamepco2025@gmail.com

# Transactional email (SMTP). The app still runs if these are empty.
# Example for Resend: host smtp.resend.com, user resend, pass re_xxxx
EMAIL_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=MCC Codebreaker <noreply@example.com>

# Optional: force a specific challenge day for local testing (1-5+). Leave empty in production.
# TEST_DAY_OVERRIDE=
